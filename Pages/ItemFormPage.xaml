<Page x:Class="DataBindingCollections_TRPO.Pages.ItemFormPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:DataBindingCollections_TRPO.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ItemFormPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <StackPanel>
            <Label Content="Название"/>
            <Label Content="Кол-во единиц"/>
            <Label Content="Цена единицы"/>
        </StackPanel>

        <StackPanel Grid.Column="1">
            <TextBox Margin="5" Text="{Binding Name}"/>
            <TextBox Margin="5" Text="{Binding Count}"/>
            <TextBox Margin="5" Text="{Binding UnitPrice}"/>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <Button Content="Сохранить" Click="AddButton_Click"/>
            <Button Content="Назад" Click="BackButton_Click"/>
        </StackPanel>
    </Grid>
</Page>
