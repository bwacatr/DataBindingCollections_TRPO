<Page x:Class="DataBindingCollections_TRPO.Pages.ListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:DataBindingCollections_TRPO.Pages" xmlns:local1="clr-namespace:DataBindingCollections_TRPO"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ListPage">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <Button Margin="5" Padding="5" Click="AddButton_Click">Добавить</Button>
            <Button Margin="5" Padding="5" Click="DeleteItem_Click">Удалить</Button>
        </StackPanel>

        <ListView Grid.Row="1" ItemsSource="{Binding Expenses}" 
                  SelectedItem="{Binding SelectedItem}"
                  MouseDoubleClick="EditItem_Click">
            
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Название: "/>
                            <TextBlock Text="{Binding Name}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Кол-во единиц: "/>
                            <TextBlock Text="{Binding Count}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Цена единицы: "/>
                            <TextBlock Text="{Binding UnitPrice}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Общая цена: "/>
                            <TextBlock Text="{Binding ExpenseTotal}"/>
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Column="1" Grid.Row="1">
            <Label Content="Идентификатор"/>
            <Label Content="Название сметы"/>
            <Label Content="Проект"/>
            <Label Content="Имя ответственного"/>
            <Label Content="Итоговая сумма сметы"/>
        </StackPanel>

        <StackPanel Grid.Column="2" Grid.Row="1">
            <StackPanel.Resources>
                <local1:BudgetEstimate x:Key="budgetEstimate"/>
            </StackPanel.Resources>
            <StackPanel.DataContext>
                <Binding Source="{StaticResource budgetEstimate}"/>
            </StackPanel.DataContext>
            <TextBlock Margin="5" Text="{Binding Id}"/>
            <TextBox Margin="5" Text="{Binding Name}"/>
            <TextBox Margin="5" Text="{Binding Project}"/>
            <TextBox Margin="5" Text="{Binding Responsible}"/>
            <TextBlock Margin="5" Text="{Binding EstimateTotal}"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal"
                    Grid.Row="2"
                    Grid.ColumnSpan="3"
                    Background="AntiqueWhite">
            <Label>Всего в списке:</Label>
            <Label Content="{Binding Expenses.Count}"/>
        </StackPanel>
    </Grid>
</Page>
